{
	"name": "claimable-neon",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Provisions temporary Lakebase Postgres databases on Neon for AI agents over the auth.md protocol.",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env.local --experimental-strip-types --watch src/local.ts",
		"start": "node --env-file-if-exists=.env.local --experimental-strip-types src/local.ts",
		"build": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:e2e": "vitest run --project e2e",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"migrate": "node --env-file-if-exists=.env.local --experimental-strip-types lib/store/migrate.ts",
		"secrets:generate": "node --experimental-strip-types scripts/generate-secrets.ts"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.0",
		"@neon/config": "^1.0.0",
		"@segment/analytics-node": "2.2.1",
		"hono": "^4.6.14",
		"jose": "^5.9.6",
		"postgres": "^3.4.5",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^24.0.0",
		"typescript": "^5.7.2",
		"vitest": "^4.1.10"
	}
}
