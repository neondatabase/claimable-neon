# .env.local — local app (`bun run dev`, migrate, test:e2e). Never a symlink.
# Linked Neon project is the Testing state DB (plain-heart-77775140, personal neon).
# neon env pull --file .env.local writes DATABASE_URL here.
#
# .env.prod — Function apply only. Never DATABASE_URL (the Function injects Postgres).
# Never a symlink. Never copy user_local / Testing-org keys here.
#
#   SENTRY_RELEASE=$(git rev-parse --short HEAD) neon deploy --profile dbx --env .env.prod \
#     --project-id soft-morning-58679842 --branch main --no-env-pull
#
# SENTRY_RELEASE is the SHA of that apply (shell prefix). Do not store it in .env.prod.
# --no-env-pull keeps Function DATABASE_URL out of .env.local.

PUBLIC_ORIGIN=http://localhost:8787
# Empty means PUBLIC_ORIGIN (localhost serves /auth.md). Production is https://neon.com/claimable.
ISSUER=
DATABASE_URL=
NEON_API_KEY=
NEON_API_KEY_KIND=user_local
NEON_ORG_API_KEY=
NEON_ORG_ID=org-old-flower-82714815
TOKEN_SIGNING_KEY=
KEY_ENCRYPTION_KEY=
PROJECT_NAME_PREFIX=claimable-local
# Dedicated analytics-events write key for https://track.neon.tech. Prod has one (source claimable-neon). Leave blank locally to skip track. Do not reuse the CLI or MCP keys.
ANALYTICS_WRITE_KEY=

PROXY_SHARED_SECRET=

# Empty disables Sentry locally. Production SENTRY_DSN lives in .env.prod.
# Production SENTRY_RELEASE is set on the deploy command, not in .env.prod.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1
PRODUCTION_BRANCH=main

# Cross-surface claim ceremony E2E
CLAIMABLE_E2E_WEBSITE_ORIGIN=http://localhost:3000
CLAIMABLE_E2E_SOURCE_API_KEY=
CLAIMABLE_E2E_RECIPIENT_API_KEY=
CLAIMABLE_E2E_RECIPIENT_ORG_ID=
